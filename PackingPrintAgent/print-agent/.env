# URL base del servidor donde corre APP PACKING. No agregues /api al final.
PACKING_SERVER_URL=http://localhost:8081

# Debe coincidir exactamente con PRINT_AGENT_TOKEN del .env del servidor.
PRINT_AGENT_TOKEN=76d49700344842513eefb4a054c6e261cf9ec9072171137cfae0a284afbaf9ae

# Identificador ÚNICO de esta computadora. El administrador lo define aquí;
# Packing lo detecta automáticamente desde el agente local, sin intervención del usuario.
# Use letras/números/guion/guion bajo. No reutilices el ID en otra PC.
PRINT_AGENT_ID=PACKING-PC-01

# Ruta al ejecutable de SumatraPDF. Ajusta si lo instalaste en otra carpeta.
SUMATRA_PATH=C:\Users\BECARIO COE\AppData\Local\SumatraPDF\SumatraPDF.exe

# Déjalo vacío para usar la impresora predeterminada de Windows.
# Si lo completas, debe coincidir exactamente con el nombre de Windows.
PRINTER_NAME=

# Intervalo entre consultas a la cola, en milisegundos.
POLL_INTERVAL_MS=3000

# El endpoint local de identidad usa el puerto fijo 17891. No requiere abrirlo en el firewall; escucha solo en 127.0.0.1.
